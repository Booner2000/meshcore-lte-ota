diff --git a/examples/simple_repeater/main.cpp b/examples/simple_repeater/main.cpp
index d475b13..2096df9 100644
--- a/examples/simple_repeater/main.cpp
+++ b/examples/simple_repeater/main.cpp
@@ -123,7 +123,13 @@ void setup() {
 }
 
 void loop() {
+#if defined(WITH_LTE_OTA) && WITH_LTE_OTA
+  lte::setStationIdentity(the_mesh.self_id.pub_key, the_mesh.getNodeName(), rtc_clock.getCurrentTime());
+#endif
   // Handle Serial CLI
+#if defined(WITH_LTE_OTA) && WITH_LTE_OTA
+  if (command[0] || !lte::pollProvisioningSerial()) {
+#endif
   int len = strlen(command);
   // `command` must stay NUL-terminated within its bounds. If it ever isn't,
   // strlen() above can return >= sizeof(command) and the loop below would then
@@ -134,6 +140,11 @@ void loop() {
   }
   while (Serial.available() && len < sizeof(command)-1) {
     char c = Serial.read();
+#if defined(WITH_LTE_OTA) && WITH_LTE_OTA
+    // Catch a reserved prefix that arrived after the earlier USB peek, before
+    // either echoing it or adding credential bytes to the ordinary CLI buffer.
+    if (len == 0 && c == '!') { lte::startProvisioningSerial(); break; }
+#endif
     if (c != '\n') {
       command[len++] = c;
       command[len] = 0;
@@ -165,6 +176,9 @@ void loop() {
     command[0] = 0;  // reset command buffer
   }
 
+#if defined(WITH_LTE_OTA) && WITH_LTE_OTA
+  }
+#endif
   board.loop();   // let the board feed its watchdog, run periodic housekeeping
 
 #ifdef ETHERNET_ENABLED
@@ -201,6 +215,9 @@ void loop() {
   ui_task.loop();
 #endif
   rtc_clock.tick();
+#if defined(WITH_LTE_OTA) && WITH_LTE_OTA
+  lte::serviceHealthTick();
+#endif
 
 #ifdef HAS_EXTERNAL_WATCHDOG
   external_watchdog.loop();
diff --git a/variants/xiao_s3_wio/XiaoS3WIOBoard.h b/variants/xiao_s3_wio/XiaoS3WIOBoard.h
index 7ae06a3..d578182 100644
--- a/variants/xiao_s3_wio/XiaoS3WIOBoard.h
+++ b/variants/xiao_s3_wio/XiaoS3WIOBoard.h
@@ -3,10 +3,36 @@
 #include <Arduino.h>
 #include <helpers/ESP32Board.h>
 
+#if defined(WITH_LTE_OTA) && WITH_LTE_OTA
+#include <LTEUpdateService.h>
+#endif
+
 class XiaoS3WIOBoard : public ESP32Board {
 public:
   XiaoS3WIOBoard() { }
 
+#if defined(WITH_LTE_OTA) && WITH_LTE_OTA
+  void begin() {
+    ESP32Board::begin();
+    lte::beginService();
+  }
+
+  bool handleCommand(const char* command, uint32_t sender_timestamp, char* reply) override {
+    // Authorization remains in MyMesh::onPeerDataRecv(); serial is privileged.
+    return lte::serviceCommand(command, reply, lte::CliReplySize);
+  }
+
+  void loop() override {
+    ESP32Board::loop();
+    lte::pollService();
+  }
+
+  void sleep(uint32_t secs) override {
+    if (lte::serviceBusy()) { delay(1); return; }
+    ESP32Board::sleep(secs);
+  }
+#endif
+
   const char* getManufacturerName() const override {
     return "Xiao S3 WIO";
   }
